# Configuração pública usada pela landing page e pelo login.
# A anon key é pública por desenho; protege os dados com RLS no Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Usada apenas por scripts locais de seed/administração.
# Nunca deve ser incluída no frontend nem em ficheiros versionados.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
