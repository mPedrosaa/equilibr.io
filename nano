// assets/js/assessments.js

const GRADE_RANGES = {
  // Ajusta conforme os ranges oficiais do teu projeto, ex: min, max, step
  min: 0,
  max: 20,
  step: 0.1
};

// Exemplo de estrutura padrão para o ficheiro de avaliações do equilibr.io

function updateFields() {
  const statusSelect = document.querySelector('#status');
  const conditionalFields = document.querySelector('#completed-fields');
  
  if (!statusSelect || !conditionalFields) return;

  if (statusSelect.value === 'completed') {
    conditionalFields.style.display = 'block';
  } else {
    conditionalFields.style.display = 'none';
  }
}

async function loadRows() {
  // Função para carregar as avaliações do Supabase
  // Certifica-te de que usas as variáveis globais 'client' e 'user' já definidas no projeto
  try {
    const { data, error } = await client
      .from('assessments')
      .select('*')
      .eq('user_id', user.id)
      .order('date', { ascending: true });

    if (error) {
      console.error('Erro ao carregar avaliações:', error.message);
      return;
    }

    render(data.filter(item => item.status === 'scheduled'));
    renderReceived(data.filter(item => item.status === 'completed' || item.received_grade !== null));
  } catch (err) {
    console.error('Erro inesperado:', err);
  }
}

function render(rows) {
  const list = document.querySelector('#assessmentList');
  if (!list) return;

  list.innerHTML = '';

  if (!rows || rows.length === 0) {
    list.innerHTML = '<p>Não tens avaliações agendadas.</p>';
    return;
  }

  rows.forEach(item => {
    const rowItem = document.createElement('div');
    rowItem.className = 'assessment-item';
    rowItem.innerHTML = `
      <div class="assessment-info">
        <strong>${item.title || 'Avaliação'}</strong> - ${item.date || ''}
        <div class="conditional-inputs" style="margin-top: 8px;">
          <label>Nota Esperada: <input type="number" name="expected_grade" class="expected-grade-input" min="0" max="20" step="0.5" value="${item.expected_grade || ''}"></label>
          <label style="margin-left: 10px;">Confiança (0-10): <input type="number" name="confidence" class="confidence-input" min="0" max="10" value="${item.confidence || ''}"></label>
        </div>
      </div>
      <div class="assessment-actions" style="margin-top: 8px;">
        <button data-complete-assessment="${item.id}" class="btn-complete">Marcar como realizado</button>
        <button data-delete-assessment="${item.id}" class="btn-delete">Eliminar</button>
      </div>
    `;
    list.appendChild(rowItem);
  });
}

function renderReceived(rows) {
  const receivedList = document.querySelector('#receivedGradeList');
  if (!receivedList) return;

  receivedList.innerHTML = '';

  if (!rows || rows.length === 0) {
    receivedList.innerHTML = '<p>Ainda não tens notas recebidas registadas.</p>';
    return;
  }

  rows.forEach(item => {
    const rowItem = document.createElement('div');
    rowItem.className = 'received-item';
    rowItem.innerHTML = `
      <div>
        <strong>${item.title || 'Avaliação'}</strong> 
        <span>(Nota Esperada: ${item.expected_grade ?? 'N/D'} | Confiança: ${item.confidence ?? 'N/D'})</span>
      </div>
      <div style="margin-top: 6px;">
        <label>Nota Recebida: <input type="number" name="received_grade" class="received-grade-input" min="0" max="20" step="0.5" value="${item.received_grade || ''}"></label>
        <button data-save-received="${item.id}" class="btn-save-received">Guardar Nota</button>
      </div>
    `;
    receivedList.appendChild(rowItem);
  });
}

// Configuração de Event Listeners globais na página
document.addEventListener('DOMContentLoaded', () => {
  const statusSelect = document.querySelector('#status');
  if (statusSelect) {
    statusSelect.addEventListener('change', updateFields);
  }

  const list = document.querySelector('#assessmentList');
  if (list) {
    list.addEventListener('click', async (event) => {
      const completeButton = event.target.closest('[data-complete-assessment]');
      const deleteButton = event.target.closest('[data-delete-assessment]');

      if (completeButton) {
        const assessmentId = completeButton.dataset.completeAssessment;
        const rowItem = completeButton.closest('.assessment-item');
        const expectedGradeInput = rowItem.querySelector('.expected-grade-input');
        const confidenceInput = rowItem.querySelector('.confidence-input');

        const expected_grade = parseFloat(expectedGradeInput.value);
        const confidence = parseInt(confidenceInput.value, 10);

        if (isNaN(expected_grade) || isNaN(confidence)) {
          alert('Por favor, preenche a nota esperada e a confiança antes de concluir.');
          return;
        }

        const { error } = await client
          .from('assessments')
          .update({ 
            status: 'completed',
            expected_grade: expected_grade,
            confidence: confidence
          })
          .eq('id', assessmentId)
          .eq('user_id', user.id);

        if (error) {
          console.error('Erro ao atualizar avaliação:', error.message);
          return;
        }

        await loadRows();
        return;
      }

      if (deleteButton) {
        const assessmentId = deleteButton.dataset.deleteAssessment;
        const { error } = await client
          .from('assessments')
          .delete()
          .eq('id', assessmentId)
          .eq('user_id', user.id);

        if (error) {
          console.error('Erro ao eliminar:', error.message);
          return;
        }

        await loadRows();
        return;
      }
    });
  }

  const receivedList = document.querySelector('#receivedGradeList');
  if (receivedList) {
    receivedList.addEventListener('click', async (event) => {
      const saveButton = event.target.closest('[data-save-received]');
      if (saveButton) {
        const assessmentId = saveButton.dataset.saveReceived;
        const rowItem = saveButton.closest('.received-item');
        const receivedGradeInput = rowItem.querySelector('.received-grade-input');

        const received_grade = parseFloat(receivedGradeInput.value);

        if (isNaN(received_grade)) {
          alert('Por favor, insere uma nota recebida válida.');
          return;
        }

        const { error } = await client
          .from('assessments')
          .update({ 
            received_grade: received_grade 
          })
          .eq('id', assessmentId)
          .eq('user_id', user.id);

        if (error) {
          console.error('Erro ao guardar nota recebida:', error.message);
          return;
        }

        await loadRows();
        return;
      }
    });
  }
});
